{
  "tmux-autoname": {
    "SessionStart": [
      {
        "type": "command",
        "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN \"${BRISHZGO_BIN:-$HOME/go/bin/brishzgo}\" -- agy-session-tmux-autoname \"$TMUX_PANE\" >/dev/null 2>&1; echo '{}'",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN \"${BRISHZGO_BIN:-$HOME/go/bin/brishzgo}\" -- agy-session-tmux-autoname \"$TMUX_PANE\" >/dev/null 2>&1; echo '{}'",
        "timeout": 5
      }
    ]
  },
  "kitty-register": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN \"${BRISHZGO_BIN:-$HOME/go/bin/brishzgo}\" -- agent-session-register agy >/dev/null 2>&1; echo '{}'",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN \"${BRISHZGO_BIN:-$HOME/go/bin/brishzgo}\" -- agent-session-register agy >/dev/null 2>&1; echo '{}'",
        "timeout": 5
      }
    ]
  },
  "auto-continue": {
    "Stop": [
      {
        "type": "command",
        "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN \"${BRISHZGO_BIN:-$HOME/go/bin/brishzgo}\" -- agent-auto-continue-hook agy \"$TMUX_PANE\" >/dev/null 2>&1; echo '{}'",
        "timeout": 5
      }
    ]
  }
}
