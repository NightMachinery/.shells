{
  "tmux-autoname": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 \"${NIGHTDIR:-$HOME/scripts}/python/agy_hook.py\" tmux \"$TMUX_PANE\" 2>/dev/null || printf '{}\\n'",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 \"${NIGHTDIR:-$HOME/scripts}/python/agy_hook.py\" tmux \"$TMUX_PANE\" 2>/dev/null || printf '{}\\n'",
        "timeout": 5
      }
    ]
  },
  "kitty-register": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 \"${NIGHTDIR:-$HOME/scripts}/python/agy_hook.py\" register 2>/dev/null || printf '{}\\n'",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 \"${NIGHTDIR:-$HOME/scripts}/python/agy_hook.py\" register 2>/dev/null || printf '{}\\n'",
        "timeout": 5
      }
    ]
  },
  "auto-continue": {
    "Stop": [
      {
        "type": "command",
        "command": "aq=\"${AGENT_QUOTAS_BIN:-$HOME/go/bin/agent-quotas}\"; if [ -x \"$aq\" ]; then \"$aq\" hook agy \"$TMUX_PANE\" 2>/dev/null || printf '{}\\n'; else python3 \"${NIGHTDIR:-$HOME/scripts}/python/agy_hook.py\" continue \"$TMUX_PANE\" 2>/dev/null || printf '{}\\n'; fi",
        "timeout": 5
      }
    ]
  }
}
