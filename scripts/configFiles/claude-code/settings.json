{
  "env": {
    "SUDO_ASKPASS": "/usr/local/libexec/claude-askpass",
    "SUDO_PROMPT": "sudo password for %p (requested by Claude Code)"
  },
  "permissions": {
    "allow": [
      "Bash(vcsh night.sh status:*)",
      "Bash(vcsh night.sh diff:*)",
      "Bash(vcsh night.sh log:*)",
      "Bash(vcsh night.sh add:*)",
      "Bash(vcsh night.sh commit:*)",
      "Bash(grep:*)",
      "Bash(python3 -m py_compile:*)",
      "WebFetch(domain:docs.anthropic.com)"
    ],
    "deny": [],
    "ask": [
      "Bash(sudo *)"
    ],
    "defaultMode": "plan"
  },
  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash bell-claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash bell-claude"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash agent-auto-continue-hook claude \"$TMUX_PANE\" >/dev/null 2>&1"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash claude-code-session-register \"$$\" >/dev/null 2>&1"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash claude-code-session-tmux-autoname \"$TMUX_PANE\" >/dev/null 2>&1"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash claude-code-session-register \"$$\" >/dev/null 2>&1"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash claude-code-session-tmux-autoname \"$TMUX_PANE\" >/dev/null 2>&1"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash bell-claude-ack >/dev/null 2>&1"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/scripts/configFiles/claude-code/statusline.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "feedbackSurveyRate": 0,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoCompactWindow": 600000,
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:profile",
  "editorMode": "vim",
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": false
}
