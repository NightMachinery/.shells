{
  "env": {
    "SUDO_ASKPASS": "/usr/local/libexec/claude-askpass",
    "SUDO_PROMPT": "sudo password for %p (requested by Claude Code)"
  },
  "permissions": {
    "allow": [
      "Bash(vcsh night.sh status:*)",
      "Bash(vcsh night.sh diff:*)",
      "Bash(vcsh night.sh log:*)",
      "Bash(vcsh night.sh add:*)",
      "Bash(vcsh night.sh commit:*)",
      "Bash(grep:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(./bring_up_fleet.sh:*)",
      "Bash(./teardown_node.sh:*)",
      "Bash(./bring_up_q27b.sh:*)",
      "Bash(gcloud compute instances:*)",
      "Bash(gcloud compute disks:*)",
      "Bash(gcloud compute regions describe:*)",
      "Bash(gcloud compute project-info describe:*)",
      "Bash(/Users/evar/code/uni/linroute/ops/bear-fleet/bring_up_fleet.sh:*)",
      "Bash(/Users/evar/code/uni/linroute/ops/bear-fleet/teardown_node.sh:*)",
      "Bash(/Users/evar/tmp/agents/LIN/0/claude/qwen27b-ops/bring_up_q27b.sh:*)",
      "Bash(/Users/evar/tmp/agents/LIN/0/claude/qwen27b-ops/teardown_node.sh:*)",
      "WebFetch(domain:docs.anthropic.com)",
      "Bash(/Users/evar/code/uni/linroute/ops/bear-fleet/:*)",
      "Bash(sh /Users/evar/code/uni/linroute/ops/bear-fleet/:*)",
      "Bash(/Users/evar/tmp/agents/LIN/0/claude/qwen27b-ops/:*)",
      "Bash(sh /Users/evar/tmp/agents/LIN/0/claude/qwen27b-ops/:*)"
    ],
    "deny": [],
    "ask": [
      "Bash(sudo *)"
    ],
    "defaultMode": "plan"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'PATH=\"$PATH:$HOME/go/bin\"; command -v night_hold >/dev/null || exit 0; exec night_hold guard'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash bell-claude \"--pane=$TMUX_PANE\" \"--node=${TMUX_SUBAGENT_NODE:+1}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash bell-claude \"--pane=$TMUX_PANE\" \"--node=${TMUX_SUBAGENT_NODE:+1}\""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash agent-auto-continue-hook claude \"$TMUX_PANE\" >/dev/null 2>&1"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash claude-code-session-register \"$$\" >/dev/null 2>&1"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash claude-code-session-tmux-autoname \"$TMUX_PANE\" >/dev/null 2>&1"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash claude-code-session-register \"$$\" >/dev/null 2>&1"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash claude-code-session-tmux-autoname \"$TMUX_PANE\" >/dev/null 2>&1"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash bell-claude-ack >/dev/null 2>&1"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/scripts/configFiles/claude-code/statusline.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "feedbackSurveyRate": 0,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 400000,
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:profile",
  "editorMode": "vim",
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "GCP: GCP read-only actions are always allowed. Mutating actions on the user's own nodes are also allowed.",
      "Subagents: sending messages to subagents is always allowed."
    ]
  },
  "voiceEnabled": false
}
