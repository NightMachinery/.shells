{
  "description": "Name the tmux session after the Codex thread, record which kitty window shows it (cmd+shift+o), and take back a session's bell notifications once it is answered; see ~/scripts/docs/tmux-session-rename.md, ~/scripts/docs/agent-sessions.md and ~/scripts/docs/bell-auto.md",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash codex-session-tmux-autoname \"$TMUX_PANE\" >/dev/null 2>&1",
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash agent-session-register codex >/dev/null 2>&1",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash codex-session-tmux-autoname \"$TMUX_PANE\" >/dev/null 2>&1",
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash agent-session-register codex >/dev/null 2>&1",
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "brishz_async=y brishz_in=MAGIC_READ_STDIN brishz2.dash bell-codex-ack >/dev/null 2>&1",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
