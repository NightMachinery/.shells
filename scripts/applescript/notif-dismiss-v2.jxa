#!/usr/bin/env -S osascript -l JavaScript
///
// * @forkedFrom
// ** https://gist.github.com/lancethomps/a5ac103f334b171f70ce2ff983220b4f
// *** https://apple.stackexchange.com/a/460171/282215
///
// [[id:31879d69-bdcd-4e81-ace3-01831fa51ab6][macOS keyboard shortcut to dismiss notifications? - Ask Different]]
///
"use strict";

// @duplicateCode/b88a767cde3e47cb1bad4b855a8989b8: notifDismissAll in
// hammerspoon/core/notif-dismiss.lua does this over Accessibility, much
// faster. This script is notif-os-dismiss-all's fallback for when Hammerspoon
// is not answering.
//
// System Events addresses each notification group by its position
// (`groups.at(i)`), and dismissing one shifts every later group up a slot. So
// we close from the last group to the first, which leaves the positions still
// to visit intact. Closing first-to-last skipped every other notification and
// then died with "Invalid index" (-1719) once many were open.
//
// Each pass reads all action names in one Apple event; per-action reads cost
// about 8 s for 20 notifications. Passes repeat until the list is empty, which
// also catches notifications that arrive, or are only drawn, mid-run.
const MAX_PASSES = 10;

function run() {
  const SystemEvents = Application("System Events");
  const NotificationCenter = SystemEvents.processes.byName("NotificationCenter");
  const notificationGroups = () => {
    const windows = NotificationCenter.windows;
    return windows.length === 0
      ? null
      : windows.at(0).groups.at(0).scrollAreas.at(0).uiElements.at(0).groups;
  };

  // Index of the action that dismisses a group: "Clear All" for a stack,
  // "Close" for a single notification.
  const closeActionIndex = (names) => {
    const clearAll = names.indexOf("Clear All");
    return clearAll >= 0 ? clearAll : names.indexOf("Close");
  };

  let remaining = 0;
  for (let pass = 0; pass < MAX_PASSES; pass++) {
    const groups = notificationGroups();
    if (groups === null) return;
    const actionNames = groups.actions.description();
    remaining = actionNames.length;
    if (remaining === 0) return;

    for (let i = remaining - 1; i >= 0; i--) {
      const j = closeActionIndex(actionNames[i]);
      if (j < 0) continue;
      try {
        groups.at(i).actions.at(j).perform();
      } catch (e) {
        // Gone already, or replaced mid-run; the next pass re-reads the list.
      }
    }
    delay(0.3);
  }
  throw new Error(`${remaining} notification group(s) remain after ${MAX_PASSES} passes`);
}
