#!/usr/bin/env dash

if test "$1" = '-c' ; then
   shift
fi

# If we ever should need supporting the featureset of brishzq.zsh, switch to:
# brishz_noquote=y brishzq.zsh "$@"

cmd="$*"
stdin="$brishz_in"
#: brishz_binary=y: exact bytes both ways, over the garden's binary transport
#: (cmd_b64, stdin_b64, binary: 1); see docs/brishz-binary.md. It needs a
#: garden in binary mode, which is the garden's default (BRISH_BINARY=0
#: turns it off). Parsed like brishzq.zsh's bool.
binary_p=''
case "$brishz_binary" in
   ''|[nN]|[nN][oO]|0) ;;
   *) binary_p=y ;;
esac
#: In binary mode stdin is streamed into base64 below instead, since `$(cat)`
#: drops trailing newlines and a shell variable cannot hold a NUL.
[ "$stdin" = 'MAGIC_READ_STDIN' ] && test -z "$binary_p" && stdin="$(cat)"
session="${brishz_session}"
nolog="${brishz_nolog}"
endpoint="${bshEndpoint:-http://127.0.0.1:${GARDEN_PORT:-7230}}/zsh/"
if test -n "$nolog" ; then
   endpoint="${endpoint}nolog/"
fi
v="${brishz_json_output:-0}"

#: `--header @file` keeps the key out of argv, which `ps` exposes to other local users.
apikey_header=''
case "$endpoint" in
    http://127.0.0.1*|https://127.0.0.1*|http://localhost*|https://localhost*)
        if test -r "$HOME/.keys/brishgarden" ; then
            apikey_header="@$HOME/.keys/brishgarden"
        fi
        ;;
esac

if test -e "$cmd" ; then
   cmd="$(cat "$cmd")" || {
      echo Bad input to brishz
      exit 1
   }
fi

#: brishz_binary=y. The command and stdin are always encoded here, as with
#: brishz_quote=y (so pass them raw, not JSON-escaped), and `binary: 1` is
#: sent on both reply paths: the plain one then answers with the exact bytes
#: of stdout followed by stderr, the JSON one adds out_b64 and err_b64.
if test -n "$binary_p" ; then
   #: jq is outside launchd's bare PATH, which Hammerspoon runs us with.
   PATH="$PATH:/usr/local/bin:/opt/homebrew/bin"
   tmp="$(mktemp -d)" || exit $?
   #: jq is not binary-safe (it turns invalid UTF-8 into U+FFFD), so the raw
   #: bytes pass through the base64 binary first. They go through files,
   #: never argv, which is size-limited and shown by `ps`. The command goes
   #: only in cmd_b64, never also in cmd: a garden that predates the _b64
   #: fields then gets an empty command and runs nothing.
   if printf '%s' "$cmd" | base64 > "$tmp/cmd" &&
      if [ "$stdin" = 'MAGIC_READ_STDIN' ] ; then
         base64 > "$tmp/stdin"
      else
         printf '%s' "$stdin" | base64 > "$tmp/stdin"
      fi &&
      jq --null-input --compact-output --rawfile c "$tmp/cmd" --rawfile i "$tmp/stdin" --arg nolog "$nolog" --arg s "$session" --arg v "$v" '{"cmd_b64": $c, "stdin_b64": $i, "binary": 1, "session": $s, "json_output": $v, "nolog": $nolog}' > "$tmp/req"
   then
      :
   else
      r=$?
      echo "brishz.dash: could not encode the binary request" >&2
      rm -rf "$tmp"
      exit "$r"
   fi

   #: brishz_async (see below): nothing reads the reply, so nothing checks
   #: its header either.
   if test -n "$brishz_async" ; then
      { curl ${apikey_header:+--header "$apikey_header"} --fail --silent --location --header 'Content-Type: application/json' --request POST --data-binary "@$tmp/req" $endpoint ; rm -rf "$tmp" ; } >/dev/null 2>&1 </dev/null &
      exit 0
   fi

   #: A garden with binary support marks its reply with X-Brish-Binary: 1.
   #: Any other garden has refused or ignored the request, so without the
   #: header we fail rather than print its reply as the command's output.
   #: Every reply is HTTP 200, so `--fail` cannot tell. The body waits in a
   #: file until the headers are checked.
   : > "$tmp/body"
   curl ${apikey_header:+--header "$apikey_header"} --fail --silent --location --dump-header "$tmp/headers" --output "$tmp/body" --header 'Content-Type: application/json' --request POST --data-binary "@$tmp/req" $endpoint
   r=$?
   if test "$r" -eq 0 ; then
      #: Header names are case-insensitive, and the garden sends this one lowercased.
      if grep -qiE '^x-brish-binary:[[:space:]]*1[[:space:]]*$' "$tmp/headers" ; then
         cat "$tmp/body"
         r=$?
      else
         echo "brishz.dash: garden lacks binary support (no X-Brish-Binary header); it predates binary mode or runs with BRISH_BINARY=0" >&2
         r=201
      fi
   fi
   rm -rf "$tmp"
   exit "$r"
fi

#: brishz_async=y: fire and forget. The request goes out from a background
#: process and this script returns at once, without the garden's answer and
#: without even the HTTP round trip. For callers that discard the output
#: anyway and must not add latency, such as Claude Code's per-prompt hooks.
#: stdin has already been read above, so the payload still arrives intact.
if test -z "$brishz_quote" ; then
   if test -n "$brishz_async" ; then
      curl ${apikey_header:+--header "$apikey_header"} --fail --silent --location --header 'Content-Type: application/json' --request POST --data "{\"cmd\":\"$cmd\", \"stdin\":\"$stdin\", \"session\":\"$session\", \"json_output\":\"$v\", \"nolog\":\"$nolog\"}" $endpoint >/dev/null 2>&1 </dev/null &
   else
      curl ${apikey_header:+--header "$apikey_header"} --fail --silent --location --header 'Content-Type: application/json' --request POST --data "{\"cmd\":\"$cmd\", \"stdin\":\"$stdin\", \"session\":\"$session\", \"json_output\":\"$v\", \"nolog\":\"$nolog\"}" $endpoint
   fi
else
    req="$(printf -- "%s " "$stdin" | jq --raw-input --slurp --null-input --compact-output --arg nolog "$nolog" --arg s "$session" --arg c "$cmd" --arg v $v 'inputs as $i | {"cmd": $c, "session": $s, "stdin": $i, "verbose": $v, "nolog": $nolog}')"
    if test -n "$brishz_async" ; then
       { printf -- "%s" "$req" | curl ${apikey_header:+--header "$apikey_header"} --fail --silent --location --header "Content-Type: application/json" --request POST --data '@-' $endpoint ; } >/dev/null 2>&1 </dev/null &
    else
       printf -- "%s" "$req" | curl ${apikey_header:+--header "$apikey_header"} --fail --silent --location --header "Content-Type: application/json" --request POST --data '@-' $endpoint
    fi
fi
