#!/usr/bin/env dash

# Source stdin in the persistent bsh session. A local file preserves Unicode
# source text and lets zsh update the session's variables and working directory.
export PATH="${PATH}:/opt/homebrew/bin:/usr/local/bin"
brishzgo="${BRISHZGO_BIN:-${HOME}/go/bin/brishzgo}"
tmp="$(command mktemp)" || exit $?
trap 'command rm -f "$tmp"' 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
command cat > "$tmp" || exit $?
brishz_async= brishz_session=bsh brishz_noquote=y "$brishzgo" -- \
    "$(command gprintf 'cd %q\nsource %q' "$PWD" "$tmp")"
exit $?
