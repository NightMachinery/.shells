#!/usr/bin/env dash

# Retain the shell-code interface and cwd cleanup; Go supplies separate output
# streams and the remote status directly, without a JSON/jq round trip.
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
case "$1" in -c|--) shift ;; esac
brishz_noquote=y exec "${BRISHZGO_BIN:-${HOME}/go/bin/brishzgo}" -- \
    "cd $(command gprintf '%q' "$PWD") ; " "$@" \
    ' ; ret=$? ; cd /tmp ; return-code $ret'
