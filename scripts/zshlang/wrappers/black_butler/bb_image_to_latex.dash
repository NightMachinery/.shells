#!/usr/bin/env dash

# BLACKBUTLER_API_ROOT='http://localhost:9000/api'
endpoint="${BLACKBUTLER_API_ROOT:-http://127.0.0.1:${BLACKBUTLER_PORT:-7260}}/image_to_latex/"

#: `--header @file` keeps the key out of argv, which `ps` exposes to other local users.
apikey_header=''
case "$endpoint" in
    http://127.0.0.1*|https://127.0.0.1*|http://localhost*|https://localhost*)
        if test -r "$HOME/.keys/blackbutler" ; then
            apikey_header="@$HOME/.keys/blackbutler"
        fi
        ;;
esac

# stdin="$(cat)"
stdin=""
image_path="${1}"

req="$(printf -- "%s " "$stdin" | jq --arg image_path "${image_path}" --raw-input --slurp --null-input --compact-output 'inputs as $i | {image_path: $image_path}')"
printf -- "%s" "$req" | curl ${apikey_header:+--header "$apikey_header"} --silent --fail --location --header "Content-Type: application/json" --request POST --data '@-' $endpoint
